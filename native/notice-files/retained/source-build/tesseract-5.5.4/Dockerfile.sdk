# Toolchain preparation only. No Tesseract source is executed with network access.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache build-base=0.5-r4 cmake=4.2.3-r0 gtest-dev=1.17.0-r1 icu-dev=78.1-r0 pango-dev=1.57.1-r0 pkgconf=2.5.1-r0 leptonica-dev=1.87.0-r0 \
 && apk info -vv > /sdk-packages.txt \
 && test -f /usr/include/gmock/gmock.h \
 && test -f /usr/include/gtest/gtest.h
