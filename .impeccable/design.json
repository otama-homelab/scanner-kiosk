  "narrative": {
    "northStar": "The Document Workbench",
    "overview": "Scanner uses a restrained, professional working surface: neutral surroundings, crisp boundaries and a recognizable indigo accent. Useful document content supplies the density; decoration does not compete with the original.\n\nThe current document route is intentionally more compact and neutral than the retained acquisition and home screens. Its local palette and control geometry are scoped by `body:has(.document-screen)` in `web/public/document-review.css`, loaded after `web/public/style.css`. These document tokens are not a claim that every route has been restyled.",
    "keyCharacteristics": [
      "Neutral working surfaces with a restrained Scanner accent.",
      "Readable working typography and compact, explicit controls.",
      "Borders and tonal separation before decorative elevation.",
      "Responsive arrangements that retain content identity and accessible names."
    ],
    "rules": [
      {
        "name": "The Scoped Surface Rule",
        "body": "Apply the document palette to the document route; preserve the home and acquisition palette outside that boundary.",
        "section": "colors"
      },
      {
        "name": "The Content Boundary Rule",
        "body": "Use a single bounded workspace with local controls rather than repeating full-size source images as decorative cards.",
        "section": "layout"
      },
      {
        "name": "The Immediate Theme Rule",
        "body": "Document-route buttons change theme without a background transition so ink and surface colors switch together.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the Scanner logo and use the existing accent for primary and selected states.",
      "Do keep labels, focus indicators and touch controls usable in Japanese and English.",
      "Do keep document controls next to the content they affect and preserve the selected page when changing views.",
      "Do distinguish document-route overrides from retained home and acquisition styles."
    ],
    "donts": [
      "Don't add decorative metrics, unsupported accuracy claims or imagery that suggests automatic correction is qualified.",
      "Don't use Unicode glyphs as substitutes for the shared SVG action icons.",
      "Don't repeat a full original image in ordinary OCR review; make comparison an explicit choice."
    ]
  }
}
