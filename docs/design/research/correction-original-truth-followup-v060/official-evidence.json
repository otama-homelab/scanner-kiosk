      "snippets": [
        {
          "line": 9,
          "text": "for k = 1 : 65"
        },
        {
          "line": 10,
          "text": "    if ~isfile(sprintf('%s/%d.png', gtdir, k))"
        },
        {
          "line": 11,
          "text": "        fprintf('%s - Not file (ref/input)\\n', sprintf('%s/%d.png', gtdir, k))"
        },
        {
          "line": 18,
          "text": "    rimg = rgb2gray(imread(sprintf('%s/%d.png', gtdir, k)));"
        },
        {
          "line": 20,
          "text": "    for m = 1 : 2"
        },
        {
          "line": 21,
          "text": "        if isfile(sprintf('%s/%d_%d.png', imdir, k, m))"
        },
        {
          "line": 25,
          "text": "            ximg = rgb2gray(imread(sprintf('%s/%d_%d.png', imdir, k, m)));"
        },
        {
          "line": 27,
          "text": "            rimg=imresize(rimg,sqrt(598400/(rh*rw)),'bicubic');"
        },
        {
          "line": 29,
          "text": "            ximg=imresize(ximg,[rh rw],'bicubic');"
        },
        {
          "line": 31,
          "text": "            [vx, vy] = siftFlow(rimg, ximg);"
        },
        {
          "line": 39,
          "text": "            fprintf('%s - Not file\\n', sprintf('%s/%d_%d.png', imdir, k, m))"
        }
      ]
    },
