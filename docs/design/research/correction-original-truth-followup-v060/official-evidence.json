          "line": 18,
          "text": "    mean_ms, mean_ld, mean_ad = eng.evalScript(os.path.join(docunet_path, \"scan\"), preds_path, verbose, nargout=3)"
        },
        {
          "line": 29,
          "text": "        os.path.join(docunet_path, \"scan\"), preds_path, os.path.join(docunet_path, crop_type)"
        }
      ]
    },
