# Compose-only runtime identity overrides: positive numeric IDs, not application settings.
# PUID=10001
# PGID=10001
# API/render/OCR and boot-pinned scan dispatch are active; scanner readiness/admission remain pending.
SCANNER_PUBLIC_URL=https://scanner.example.test
SCANNER_LISTEN_ADDR=:8080
SCANNER_AUTHENTICATE_TYPE=oidc
SCANNER_AUTH_LOGIN_REQUESTS_PER_MINUTE=10
SCANNER_AUTH_LOGIN_BURST=5
SCANNER_OIDC_ISSUER=https://id.example.test
SCANNER_OIDC_CLIENT_ID=scanner
SCANNER_OIDC_CLIENT_AUTH=client_secret_basic
SCANNER_OIDC_CLIENT_SECRET=
SCANNER_OIDC_SCOPES=openid,profile
SCANNER_OIDC_ADMIN_GROUPS=[]
SCANNER_STATE_DIR=/var/lib/scanner/state
SCANNER_DOCUMENT_DIR=/var/lib/scanner/documents
# Scanner display names: 1–256 Unicode code points; over-limit names fail startup without truncation.
SCANNER_SCANNERS_JSON=[{"id":"scanner_example_0001","name":"Network scanner","driver":"sane-airscan","endpoint":"http://192.0.2.10/eSCL"}]
# Core-only Docker deployment: OCR is disabled and its controls are hidden.
# Optional Tesseract: deploy/compose.tesseract.yaml; LLM: set both values to llm.
SCANNER_OCR_PLUGINS=
SCANNER_OCR_DEFAULT_PLUGIN=
SCANNER_OCR_DEFAULT_LANGUAGES=ja,en
# Internal local-adapter overrides; the default core image has no Tesseract engine/data.
# SCANNER_OCR_TESSERACT_PATH=/usr/bin/tesseract
# SCANNER_OCR_TESSERACT_DATA_DIR=/usr/share/tesseract-ocr/5/tessdata
# Optional terminal Tesseract API, worker only. Set plugin/default to tesseract too.
# An absent endpoint selects the internal local adapter, which needs separately installed tools.
# Endpoint discovery sends no image; native recognition has no automatic fallback/retry.
# SCANNER_OCR_TESSERACT_ENDPOINT=https://ocr.example
# SCANNER_OCR_TESSERACT_API_KEY=  # generate a private random secret, e.g. openssl rand -hex 32
# SCANNER_OCR_TESSERACT_DESTINATION=Tesseract OCR service
# SCANNER_OCR_TESSERACT_ALLOW_INSECURE_HTTP=false
# Service-only limits and protocol: docs/design/tesseract-api.md.
SCANNER_OCR_LLM_PROFILES_JSON=[]
# Optional worker-readable, license-approved TrueType font for positioned LLM PDF layers.
SCANNER_OCR_LLM_TEXT_LAYER_FONT=
# To enable a verified endpoint, add llm to SCANNER_OCR_PLUGINS and set profiles.
# Example metadata (no credentials):
# SCANNER_OCR_LLM_PROFILES_JSON=[{"id":"local-vision","name":"Local vision","processing_destination":"Your approved OCR server","protocol":"chat-completions","endpoint":"http://192.0.2.20:8000/v1/chat/completions","allow_insecure_http":true,"api_key_env":"SCANNER_OCR_LLM_KEY_LOCAL","model":"replace-with-verified-model-id","response_model":"replace-with-exact-response-model-id","version":"deployment-v1","languages":["ja","en"],"outputs":["text","positioned_text"],"max_completion_tokens":8192,"token_parameter":"max_completion_tokens"}]
# SCANNER_OCR_LLM_KEY_LOCAL=  # worker secret only; omit api_key_env for a keyless local endpoint
SCANNER_SESSION_LIFETIME_SECONDS=28800
SCANNER_SESSION_IDLE_SECONDS=1800
SCANNER_RETENTION_SECONDS=86400
SCANNER_RECEIPT_RETENTION_SECONDS=259200
SCANNER_USER_MAX_DOCUMENTS=20
SCANNER_USER_MAX_BYTES=524288000
# Logical artifact + reservation budget; physical disk free-space checks are separate.
SCANNER_GLOBAL_MAX_BYTES=1073741824
SCANNER_MIN_FREE_BYTES=67108864
SCANNER_JOB_MAX_PAGES=50
SCANNER_JOB_MAX_BYTES=209715200
SCANNER_MAX_PAGE_PIXELS=40000000
SCANNER_PROCESSING_CONCURRENCY=1
SCANNER_SCAN_TIMEOUT_SECONDS=120
# Worker-only physical GC attempt, independent of content/receipt retention (1–900).
SCANNER_CLEANUP_TIMEOUT_SECONDS=300
SCANNER_OCR_TIMEOUT_SECONDS=600
SCANNER_PROCESS_STOP_GRACE_SECONDS=15
SCANNER_OCR_MAX_RESULT_BYTES=16777216
SCANNER_LOG_LEVEL=info
# API keys for enabled LLM profiles are separate environment secrets, never profile JSON literals.
# Paperless settings and credentials are not initial-release configuration.

# API role only: process-local request admission limits.
SCANNER_API_MAX_INFLIGHT=32
SCANNER_API_REQUESTS_PER_MINUTE=600
SCANNER_API_BURST=32

# API-only maximum image/download transfer duration; capped by document expiry.
SCANNER_TRANSFER_TIMEOUT_SECONDS=300

# Worker-only OCR capability authority lease (15–300 seconds).
SCANNER_OCR_CATALOG_LEASE_SECONDS=30

# Worker-only native scanner session (readiness and scan HTTP admission remain pending).
# Enable only after the previous scanner writer is stopped; does not establish readiness.
SCANNER_SCAN_CONCURRENCY=1
SCANNER_ACQUISITION_ENABLED=false
# SCANNER_SCANIMAGE_PATH=/usr/bin/scanimage
# SCANNER_SANE_PARAMETERS_PATH=/usr/libexec/scanner/sane-parameters
# SCANNER_SANE_LIBRARY_DIRS_JSON=[]
# Optional explicit PEM trust override. Onefile supplies its bundled CA by default.
# Requires the TLS-verifying backend; an empty value is invalid worker config.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Worker role only: standard Go soft runtime memory limit; not an RSS/cgroup limit.
# Native/OCR children require separate combined-resource acceptance.
GOMEMLIMIT=1024MiB
